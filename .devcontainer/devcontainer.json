{
  "name": "dev-team-agents",
  "image": "ghcr.io/jodavis/devcontainer-template/base:latest",
  "features": {
    "ghcr.io/jodavis/devcontainer-template/git-askpass:1": {}
  },
  "mounts": [
    "source=dev-team-agents-claude-config,target=/home/vscode/.claude,type=volume",
    "source=agent-plugins-home,target=/workspaces/agent-plugins,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GIT_ASKPASS": "/usr/local/bin/git-askpass"
  },
  "runArgs": ["--name", "vscode-devteamagents"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
